#include <stdio.h>
#include <stdint.h>
#include <RCC.h>
#include <GPIO.h>
#include <EXTI.h>
#include <TIME.h>
#include <ADC.h>

uint16_t value ;

int main() 
{	
	
    RCC_Enable_PortA();
//	RCC_Enable_PortC();
//	RCC_Enable_TIM2();
	RCC_Enable_ADC1();
	
    
	GPIO_Config(GPIOA, GPIO_PIN_0,  GPIO_Mode_Input_Analog);

	
	ADC01_CH0_Init();
	
	while (1)
	{
		value = ADC01_CH0_Read();
		
	}
}
